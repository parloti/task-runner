{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Emit
    "declaration": true,
    "declarationMap": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "paths": { "#root": ["./src/index.ts"] }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.spec.ts", "src/**/__tests__/**"]
}
