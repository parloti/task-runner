{
  "packages": {
    ".": {
      "check:rules": { "run": { "kind": "npm", "script": "check:rules" } },
      "clean": { "run": { "kind": "npm", "script": "clean" } },
      "compile": {
        "dependsOn": ["clean"],
        "run": { "kind": "npm", "script": "compile" }
      },
      "eslint": { "run": { "kind": "npm", "script": "eslint" } },
      "eslint:inspect": {
        "run": { "kind": "npm", "script": "eslint:inspect" }
      },
      "fmt": { "run": { "kind": "npm", "script": "fmt" } },
      "lint:staged": { "run": { "kind": "npm", "script": "lint:staged" } },
      "pack": {
        "dependsOn": ["build"],
        "run": { "kind": "npm", "script": "pack" }
      },
      "prettier": { "run": { "kind": "npm", "script": "prettier" } },
      "resolve-paths": {
        "dependsOn": ["compile"],
        "run": { "kind": "npm", "script": "resolve-paths" }
      },
      "tdd": { "run": { "kind": "npm", "script": "tdd" } },
      "test": { "run": { "kind": "npm", "script": "test" } },
      "typecheck": { "run": { "kind": "npm", "script": "typecheck" } },
      "e2e": { "run": { "kind": "npm", "script": "e2e" } },
      "mutation": {
        "dependsOn": ["test"],
        "run": { "kind": "npm", "script": "mutation" }
      },
      "build": { "dependsOn": ["clean", "compile", "resolve-paths"] },
      "lint": { "dependsOn": ["prettier", "eslint"] },
      "eslint:fix-command": {
        "dependsOn": ["check:rules"],
        "run": { "kind": "npm", "script": "eslint", "args": ["--fix"] }
      },
      "eslint:fix": { "dependsOn": ["check:rules", "eslint:fix-command"] },
      "lint:fix": { "dependsOn": ["fmt", "eslint:fix"] },
      "test:all": { "dependsOn": ["test", "e2e", "mutation"] },
      "docs": {
        "dependsOn": ["build"],
        "run": { "kind": "npm", "optional": true, "script": "docs" }
      },
      "validate": {
        "dependsOn": ["build", "pack", "typecheck", "lint", "docs", "test:all"]
      }
    }
  },
  "version": 2
}
