{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task Runner configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "packages"],
  "properties": {
    "$comment": {
      "type": "string",
      "description": "Optional configuration comment, commonly used to mark generated files."
    },
    "version": { "const": 2 },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "description": "Values used when a command-line option is omitted.",
      "properties": {
        "ci": { "type": "boolean" },
        "collapse": { "type": "boolean" },
        "concurrency": {
          "description": "A positive integer fixes the command limit; auto adjusts it to available CPU and memory resources.",
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            { "const": "auto" }
          ]
        },
        "keepGoing": {
          "type": "boolean",
          "description": "Continue independent tasks after a command fails (the default); false stops admission and cancels active work. Tasks that depend on a failed task remain blocked."
        },
        "maxTasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "noCache": {
          "type": "boolean",
          "description": "Bypass cache reads and refresh successful records by default."
        },
        "scroll": { "type": "boolean" }
      }
    },
    "packages": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:\\.|(?!(?:\\.{1,2})(?:/|$))[^/\\\\:#]+(?:/(?!(?:\\.{1,2})(?:/|$))[^/\\\\:#]+)*)$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "pattern": "^[^#]*[^#\\s][^#]*$" },
        "additionalProperties": { "$ref": "#/$defs/task" }
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cache": { "$ref": "#/$defs/cache" },
        "dependsOn": {
          "description": "Group members for commandless tasks. For commands, ordering constraints only between tasks already selected; earlier tasks are not automatically included.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:[^#]+#)?[^#]*[^#\\s][^#]*$"
          }
        },
        "run": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "script"],
              "properties": {
                "kind": { "const": "npm" },
                "script": { "type": "string", "pattern": "\\S" },
                "args": { "type": "array", "items": { "type": "string" } },
                "optional": { "type": "boolean" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "command"],
              "properties": {
                "kind": { "const": "shell" },
                "command": { "type": "string", "pattern": "\\S" }
              }
            }
          ]
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs"],
      "properties": {
        "inputs": {
          "description": "Config-root-relative file patterns whose names and contents determine reuse.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/cachePattern" }
        },
        "exclude": {
          "type": "array",
          "items": { "$ref": "#/$defs/cachePattern" }
        },
        "outputs": {
          "description": "Artifact patterns; every pattern must match files whose contents remain unchanged.",
          "type": "array",
          "items": { "$ref": "#/$defs/cachePattern" }
        },
        "env": {
          "type": "array",
          "items": { "type": "string", "pattern": "\\S" }
        }
      }
    },
    "cachePattern": {
      "type": "string",
      "pattern": "^(?![!/])(?!.*:)(?!.*\\\\(?![()*?{}\\[\\]!]))(?!.*(?:^|/)\\.{1,2}(?:/|$)).*\\S.*$"
    }
  }
}
